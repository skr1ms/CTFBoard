APP_NAME=AstroCTFb
APP_VERSION=1.0.0
CHI_MODE=production
LOG_LEVEL=info
BACKEND_PORT=8080
API_BASE_URL=https://api.ctfleague.ru
MIGRATIONS_PATH=migrations
VERIFY_EMAILS=true
COMPETITION_MODE=flexible
ALLOW_TEAM_SWITCH=true
MIN_TEAM_SIZE=1
MAX_TEAM_SIZE=10
HTTP_SHUTDOWN_TIMEOUT=15

# ---------------------------------------------------------------------------
# Vault - required in production. When set, ALL secrets below marked
# "(Vault)" are fetched from Vault at startup and env values are ignored.
# ---------------------------------------------------------------------------
VAULT_ADDR=https://vault.example.com
VAULT_PORT=8200
VAULT_TOKEN=your_production_vault_token_here
VAULT_MOUNT_PATH=secret

# ---------------------------------------------------------------------------
# Secrets - only set these if you are NOT using Vault.
# In production leave them empty; provision via Vault paths listed in docs/ENVIRONMENT.md.
# ---------------------------------------------------------------------------

# (Vault: astroctfb/app --> flag_encryption_key) min 32 bytes
FLAG_ENCRYPTION_KEY=

# (Vault: astroctfb/database --> user / password / dbname)
POSTGRES_USER=admin
POSTGRES_PASSWORD=
POSTGRES_DB=board
POSTGRES_MAX_CONNS=150

# (Vault: astroctfb/redis --> password)
REDIS_PASSWORD=

# (Vault: astroctfb/jwt --> access_secret / refresh_secret) min 32 chars each
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# (Vault: astroctfb/resend --> api_key)
RESEND_API_KEY=

# (Vault: astroctfb/storage --> access_key / secret_key)
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

# (Vault: astroctfb/admin --> username / email / password) - optional seed
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@ctfleague.ru
ADMIN_PASSWORD=

# (Vault: astroctfb/oauth --> state_secret / github_client_id / github_client_secret / google_client_id / google_client_secret)
OAUTH_STATE_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Non-secret configuration - always set via env, never managed by Vault.
# ---------------------------------------------------------------------------

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSL_MODE=require

REDIS_HOST=redis
REDIS_PORT=6379

JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=72

FRONTEND_URL=https://ctfleague.ru
CORS_ORIGINS=https://ctfleague.ru

# Optional: behind reverse proxy
TRUSTED_PROXY_CIDRS=
METRICS_ALLOWED_IPS=

RESEND_ENABLED=true
RESEND_FROM_EMAIL=noreply@ctfleague.ru
RESEND_FROM_NAME=CTFLeague
RESEND_VERIFY_TTL_HOURS=24
RESEND_RESET_TTL_HOURS=1

RATE_LIMIT_SUBMIT_FLAG=10
RATE_LIMIT_SUBMIT_FLAG_DURATION=1

# OAuth redirect URLs (not a secret; client credentials come from Vault)
OAUTH_GITHUB_REDIRECT_URL=https://api.ctfleague.ru/api/v1/auth/oauth/github/callback
OAUTH_GOOGLE_REDIRECT_URL=https://api.ctfleague.ru/api/v1/auth/oauth/google/callback

STORAGE_PROVIDER=s3
STORAGE_S3_ENDPOINT=seaweedfs:8333
STORAGE_S3_PUBLIC_ENDPOINT=https://s3.ctfleague.ru
STORAGE_S3_BUCKET=tasks
STORAGE_S3_REGION=us-east-1
STORAGE_S3_USE_SSL=false
STORAGE_PRESIGNED_EXPIRY_MINUTES=60

# ---------------------------------------------------------------------------
# Docker stack (docker-compose only; not read by the backend)
# ---------------------------------------------------------------------------

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=secure_grafana_password
GRAFANA_PORT=3000

SEAWEED_S3_PORT=8333
SEAWEEDFS_UI_PORT=5000
SEAWEEDFS_UI_IMAGE=astroctfb-seaweedfs-ui

VITE_API_URL=https://api.ctfleague.ru
VITE_HOST=s3.ctfleague.ru
VITE_FILER_PORT=8888
VITE_MASTER_PORT=9333
VITE_MASTER_PROXY_PATH=master
VITE_FILER_PROXY_PATH=filer

BACKEND_IMAGE=astroctfb-backend:latest
