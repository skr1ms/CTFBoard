# ---------------------------------------------------------------------------
# Vault - local dev uses a Vault dev container (token = "root").
# vault-init reads the secrets block below and writes them to Vault.
# The backend then reads secrets from Vault, not from env directly.
# ---------------------------------------------------------------------------
VAULT_ADDR=http://vault:8200
VAULT_PORT=8200
VAULT_TOKEN=root

# ---------------------------------------------------------------------------
# Secrets - read by vault-init to bootstrap Vault paths.
# The backend does NOT use these directly; it fetches them from Vault.
# Omit any value to let init-vault.sh generate a random one.
# ---------------------------------------------------------------------------

# (Vault: astroctfb/app -> flag_encryption_key) must be 64 hex chars (32 bytes)
FLAG_ENCRYPTION_KEY=1234567890123456789012345678901212345678901234567890123456789012

# (Vault: astroctfb/database -> user / password / dbname)
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=board
POSTGRES_MAX_CONNS=150
POSTGRES_MIN_CONNS=10

# (Vault: astroctfb/redis -> password)
REDIS_PASSWORD=admin

# (Vault: astroctfb/jwt -> access_secret / refresh_secret) leave empty to auto-generate
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# (Vault: astroctfb/resend -> api_key)
RESEND_API_KEY=your_api_key_here

# (Vault: astroctfb/storage -> access_key / secret_key) must match SeaweedFS s3.json
SEAWEED_S3_ACCESS_KEY=admin
SEAWEED_S3_SECRET_KEY=admin

# Direct S3 credentials (only without Vault; in production use Vault path astroctfb/storage)
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

# (Vault: astroctfb/admin -> username / email / password)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin

# (Vault: astroctfb/oauth -> state_secret / *_client_id / *_client_secret) leave empty to auto-generate state_secret
OAUTH_STATE_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Non-secret configuration - used by docker-compose to configure the backend.
# Never managed by Vault.
# ---------------------------------------------------------------------------

APP_NAME=AstroCTFb
APP_VERSION=1.0.0
LOG_LEVEL=debug
STRUCTURED_LOGGER=true
DEBUG_ENABLED=false
SECURE_COOKIES=false
BACKEND_PORT=8090
API_BASE_URL=http://localhost:8090
MIGRATIONS_PATH=migrations
VERIFY_EMAILS=false
COMPETITION_MODE=flexible
ALLOW_TEAM_SWITCH=true
MIN_TEAM_SIZE=1
MAX_TEAM_SIZE=10
HTTP_SHUTDOWN_TIMEOUT=15

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSL_MODE=disable

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_POOL_SIZE=50
REDIS_MIN_IDLE=10

JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=72
JWT_ISSUER=astroctfb

FRONTEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000,http://localhost:5173,http://localhost:5000

TRUSTED_PROXY_CIDRS=
METRICS_ALLOWED_IPS=

RESEND_ENABLED=false
RESEND_FROM_EMAIL=noreply@example.com
RESEND_FROM_NAME=AstroCTFb
RESEND_VERIFY_TTL_HOURS=24
RESEND_RESET_TTL_HOURS=1

RATE_LIMIT_SUBMIT_FLAG=1000
RATE_LIMIT_SUBMIT_FLAG_DURATION=1

# OAuth redirect URLs (not a secret; client credentials come from Vault)
OAUTH_GITHUB_REDIRECT_URL=http://localhost:8090/api/v1/auth/oauth/github/callback
OAUTH_GOOGLE_REDIRECT_URL=http://localhost:8090/api/v1/auth/oauth/google/callback

STORAGE_PROVIDER=s3
STORAGE_LOCAL_PATH=./uploads
STORAGE_S3_ENDPOINT=seaweedfs:8333
STORAGE_S3_PUBLIC_ENDPOINT=http://localhost:8333
STORAGE_S3_BUCKET=ctf
STORAGE_S3_REGION=us-east-1
STORAGE_S3_USE_SSL=false
STORAGE_PRESIGNED_EXPIRY_MINUTES=60

# ---------------------------------------------------------------------------
# Docker stack (docker-compose only; not read by the backend)
# ---------------------------------------------------------------------------

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3000
GF_SERVER_ROOT_URL=http://localhost:3000

# Alertmanager -> Telegram notifications (not used in local dev)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SEAWEED_S3_PORT=8333
SEAWEEDFS_UI_PORT=5000
SEAWEEDFS_UI_IMAGE=astroctfb-seaweedfs-ui

VITE_API_URL=http://localhost:8090
VITE_HOST=localhost
VITE_FILER_PORT=8888
VITE_MASTER_PORT=9333
VITE_MASTER_PROXY_PATH=master
VITE_FILER_PROXY_PATH=filer

BACKEND_IMAGE=astroctfb-backend-local
